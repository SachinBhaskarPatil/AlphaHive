# General
App_Name="Market-Rover"

# AI Models — OpenAI (default)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
# LLM_FLASH_MODEL=gpt-4o-mini
# LLM_PRO_MODEL=gpt-4o
# Optional Gemini fallback:
# GOOGLE_API_KEY=your-google-api-key

# GitHub Integration (For Agent Ops)
GITHUB_ISSUE_ASSIGNEES="user1,user2"
GITHUB_ISSUE_LABELS="bug,enhancement"

# Optional: Tracking / Analytics
TRACKING_ENABLED="true"
